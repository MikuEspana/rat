# RAT RACE configuration. Copy to .env for local use. NEVER commit a real .env.
# Secrets marked [SECRET] go only in your host's secret store (Railway variables), never in git.

# ---------- mode and safety ----------
NODE_ENV=development
LOG_LEVEL=info
# DRY_RUN=true builds, signs and SIMULATES every transaction but never sends. Default ON.
DRY_RUN=true
# Going live needs DRY_RUN=false AND this exact phrase: I_UNDERSTAND_THIS_SENDS_MAINNET_TRANSACTIONS
LIVE_CONFIRM=
# true blocks every new transaction. Can also be flipped in the database with the CLI (rat kill / rat resume).
KILL_SWITCH=false
# Smoke test mode: hard lifetime spend cap for the whole bot (SMOKE_CAP_SOL).
SMOKE_MODE=false
SMOKE_CAP_SOL=0.1

# ---------- database ----------
# [SECRET] Worker and CLI: use a DIRECT (session) connection, needed for the single-worker lock.
DATABASE_URL=
# [SECRET] API: read-only user, pooler connection is fine.
DATABASE_URL_READONLY=

# ---------- keys ----------
# [SECRET] 32 random bytes, base64. Encrypts every private key stored in the database.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEY_ENCRYPTION_KEY=
KEY_VERSION=1
# Public keys only. The private keys are imported with the CLI (rat keys import --role creator|fund).
CREATOR_PUBKEY=
FUND_PUBKEY=

# ---------- chain ----------
# [SECRET] Mainnet RPC (Helius or similar) and a backup.
RPC_URL=
RPC_URL_BACKUP=
# The RAT coin mint. Empty until launch; claims and burns are skipped while empty.
COIN_MINT=
# Wallet watch floor: transactions of the creator/fund wallets before this slot are never looked at. Set it to the
# coin launch slot + 1 BEFORE the first live start (docs/runbooks/go-live.md). 0 = the slot of the first live run.
WATCH_FROM_SLOT=0
# Signatures of transactions YOU signed with the creator or fund wallet (the coin launch, a manual transfer),
# comma separated. The wallet watch accepts them instead of engaging the kill switch.
KNOWN_OWNER_TX_SIGS=
PRIORITY_FEE_MICROLAMPORTS_MAX=200000
COMPUTE_UNIT_LIMIT_SWAP=400000
COMPUTE_UNIT_LIMIT_CLAIM=200000
# Expected mint authority shared by all xStocks. Empty = use the authority shared by the majority (min 3) of configured mints.
XSTOCKS_MINT_AUTHORITY=

# ---------- jupiter ----------
# [SECRET] Free key from portal.jup.ag
JUPITER_API_KEY=
JUPITER_BASE_URL=https://api.jup.ag
# Free tier is 60 requests/min. Raise this if you upgrade the plan.
JUPITER_MAX_RPM=55

# ---------- economics ----------
HIRE_SPLIT_BPS=5000
SALARY_SOL=0.03
HIRE_OVERHEAD_EST_SOL=0.0025
RAT_BUFFER_SOL=0.003
# single = one atomic tx (creator funds rat + rat buys stock). two_step = fund tx, then swap tx.
HIRE_MODE=single
MIN_CLAIM_SOL=0.005
MIN_BURN_SOL=0.01
CREATOR_RESERVE_SOL=0.05
FUND_RESERVE_SOL=0.01
# 10 = about 17 rats a minute, steady under the 30 SOL/h cap (SIMULATION.md). 20 hires in bursts and pauses.
MAX_HIRES_PER_LOOP=10
MIN_STOCK_WEIGHT_BPS=500
SLIPPAGE_BPS_STOCK=100
# Coin buy slippage for burns (1.5%): a tight limit caps what a sandwich can take.
SLIPPAGE_BPS_COIN=150
MAX_PRICE_IMPACT_PCT=2
# Alert when no rat was hired for HIRE_IDLE_ALERT_MIN minutes while more than HIRE_IDLE_ALERT_SOL waits in the hire budget.
HIRE_IDLE_ALERT_MIN=30
HIRE_IDLE_ALERT_SOL=0.1
# Hard caps per bucket, rolling 60 minutes. Alert when a bucket crosses SPEND_ALERT_PCT of its cap.
SPEND_CAP_SOL_PER_HOUR_HIRE=30
SPEND_CAP_SOL_PER_HOUR_BURN=30
SPEND_ALERT_PCT=50

# ---------- loops ----------
CLAIM_INTERVAL_SEC=35
# Burn rounds start a random 8 to 12 minutes apart (never a fixed public schedule). Rounds above BURN_CHUNK_MAX_SOL
# are split into equal chunks sent BURN_CHUNK_GAP_MIN_SEC to BURN_CHUNK_GAP_MAX_SEC seconds apart.
BURN_INTERVAL_MIN_SEC=480
BURN_INTERVAL_MAX_SEC=720
BURN_CHUNK_MAX_SOL=1
# At most this much per burn round (0 = no limit). 5 spreads the 30 SOL/h burn cap evenly over the hour instead of
# hitting it in the first 20 minutes and pausing (SIMULATION.md, 3-hour launch).
BURN_ROUND_MAX_SOL=5
BURN_CHUNK_GAP_MIN_SEC=3
BURN_CHUNK_GAP_MAX_SEC=8
# rpc = normal send. jito = burns go to the Jito block engine as bundle-only transactions with a tip (paid from the
# burn budget), never to a public RPC. Off until tested with the smoke test (OPEN-QUESTIONS #12).
BURN_SEND_VIA=rpc
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf/api/v1
JITO_TIP_SOL=0.0001
PRICE_INTERVAL_SEC=15
FREEZE_INTERVAL_SEC=35
PRICE_STALE_SEC=900
RECONCILE_BATCH=500
# Dry run rehearsal only: pretend this much SOL/hour of fees is claimable (ignored when DRY_RUN=false).
DRY_RUN_FAKE_CLAIM_SOL_PER_HOUR=0

# ---------- alerts ----------
# [SECRET]
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- api ----------
API_PORT=8080
API_CACHE_SEC=3
CORS_ORIGIN=*

# ---------- files ----------
STOCKS_FILE=config/stocks.json

# ---------- admin page (apps/admin, a separate private service) ----------
# At least 16 characters. Log in with any user name and this password (HTTPS only).
ADMIN_PASSWORD=
# Railway injects PORT; ADMIN_PORT is only a fallback for local runs.
ADMIN_PORT=8790
