# IDLE INU configuration. Copy to .env for local use. NEVER commit a real .env.
# Secrets marked [SECRET] go only in your host's secret store (Railway variables), never in git.

# ---------- mode and safety ----------
NODE_ENV=development
LOG_LEVEL=info
# DRY_RUN=true builds, signs and SIMULATES every transaction but never sends. Default ON.
DRY_RUN=true
# Going live needs DRY_RUN=false AND this exact phrase: I_UNDERSTAND_THIS_SENDS_MAINNET_TRANSACTIONS
LIVE_CONFIRM=
# true blocks every new transaction. Can also be flipped in the database with the CLI (rat kill / rat resume).
KILL_SWITCH=false
# Smoke test mode: hard lifetime spend cap for the whole bot (SMOKE_CAP_SOL).
SMOKE_MODE=false
SMOKE_CAP_SOL=0.1
# Rehearsal only (docs/runbooks/rehearsal.md). Never true in production: refused with the production creator wallet
# and on a production database. Turns on `rat staging-seed` and the one-shot crash test below.
STAGING=false
STAGING_CRASH_AFTER_SEND=0
STAGING_STAGE_SCALE=1

# ---------- database ----------
# [SECRET] Worker, admin and CLI: a DIRECT (session) connection, needed for the single-worker lock.
# On Railway: ${{Postgres.DATABASE_URL}} (a reference, no password copied). See docs/runbooks/deploy.md.
DATABASE_URL=
# [SECRET] API: the read-only user. On Railway:
# postgresql://rat_api:${{RAT_API_DB_PASSWORD}}@${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
DATABASE_URL_READONLY=

# ---------- keys ----------
# [SECRET] 32 random bytes, base64. Encrypts every private key stored in the database.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEY_ENCRYPTION_KEY=
KEY_VERSION=1
# Public key only. The private key is imported with the CLI (rat keys import --role creator).
CREATOR_PUBKEY=
# Public key of YOUR cold wallet (the bot has no key for it): where `rat sweep` moves the rats' tokens in an emergency.
COLD_WALLET=

# ---------- chain ----------
# [SECRET] Mainnet RPC (Helius or similar) and a backup.
RPC_URL=
RPC_URL_BACKUP=
# The RAT coin mint. Empty until launch; claims are skipped while empty.
COIN_MINT=
# Wallet watch floor: transactions of the creator wallet before this slot are never looked at. Set it to the
# coin launch slot + 1 BEFORE the first live start (docs/runbooks/go-live.md). 0 = the slot of the first live run.
WATCH_FROM_SLOT=0
# Signatures of transactions YOU signed with the creator wallet (the coin launch, a manual transfer),
# comma separated. The wallet watch accepts them instead of engaging the kill switch.
KNOWN_OWNER_TX_SIGS=
PRIORITY_FEE_MICROLAMPORTS_MAX=200000
COMPUTE_UNIT_LIMIT_SWAP=400000
COMPUTE_UNIT_LIMIT_CLAIM=200000
# Expected mint authority shared by all xStocks. Empty = use the authority shared by the majority (min 3) of configured mints.
XSTOCKS_MINT_AUTHORITY=

# ---------- jupiter ----------
# [SECRET] Free key from portal.jup.ag
JUPITER_API_KEY=
JUPITER_BASE_URL=https://api.jup.ag
# We stay on the Free tier (60 requests per 60 s sliding window, per organisation). Hard cap on the worker's calls
# (prices + builds + retries) in any 60 s: at most 40 (a higher value is refused), leaving 20 for the CLI and scripts.
# When the budget is used up, hires wait for the next loop. A 429 backs off (5 s doubling to 5 min) and alerts.
JUPITER_MAX_RPM=40

# ---------- economics ----------
# Every claimed lamport pays for rats. Nothing is bought back or burned, nothing is paid to holders.
SALARY_SOL=0.03
HIRE_OVERHEAD_EST_SOL=0.0025
RAT_BUFFER_SOL=0.003
# single = one atomic tx (creator funds rat + rat buys stock). two_step = fund tx, then swap tx.
HIRE_MODE=single
MIN_CLAIM_SOL=0.005
CREATOR_RESERVE_SOL=0.05
# 20 per 35 s loop = about 34 rats a minute, just over the 60 SOL/h cap's pace: the office fills evenly (SIMULATION.md).
MAX_HIRES_PER_LOOP=20
MIN_STOCK_WEIGHT_BPS=500
SLIPPAGE_BPS_STOCK=100
MAX_PRICE_IMPACT_PCT=2
# Alert when no rat was hired for HIRE_IDLE_ALERT_MIN minutes while more than HIRE_IDLE_ALERT_SOL waits in the hire budget.
HIRE_IDLE_ALERT_MIN=30
HIRE_IDLE_ALERT_SOL=0.1
# Hard cap on hiring, rolling 60 minutes (60 SOL = about 2,000 rats an hour). What it holds back waits and is spent
# later. Alert when spending crosses SPEND_ALERT_PCT of the cap.
SPEND_CAP_SOL_PER_HOUR_HIRE=60
SPEND_ALERT_PCT=50

# ---------- loops ----------
CLAIM_INTERVAL_SEC=35
# One batched Jupiter Price call for every mint. The site smooths the portfolio numbers between updates.
PRICE_INTERVAL_SEC=45
FREEZE_INTERVAL_SEC=35
PRICE_STALE_SEC=900
RECONCILE_BATCH=500
# Dry run rehearsal only: pretend this much SOL/hour of fees is claimable (ignored when DRY_RUN=false).
DRY_RUN_FAKE_CLAIM_SOL_PER_HOUR=0

# ---------- alerts ----------
# [SECRET]
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- api ----------
API_PORT=8080
API_CACHE_SEC=3
CORS_ORIGIN=*

# ---------- files ----------
STOCKS_FILE=config/stocks.json
# Symbols you verified on xstocks.fi, comma separated (for example TSLAx,AAPLx): approved on top of the stocks file.
# Each one must still pass the on-chain mint check before any rat is hired into it.
APPROVED_STOCKS=

# ---------- admin page (apps/admin, a separate private service) ----------
# At least 16 characters. Log in with any user name and this password (HTTPS only).
ADMIN_PASSWORD=
# Railway injects PORT; ADMIN_PORT is only a fallback for local runs.
ADMIN_PORT=8790

# ---------- database on Railway (docs/runbooks/deploy.md step 1) ----------
# [SECRET] On the api service: the password of the API's read-only user rat_api (openssl rand -hex 32).
# DATABASE_URL_READONLY references it (${{RAT_API_DB_PASSWORD}}), so it is typed once.
RAT_API_DB_PASSWORD=

# ---------- backup service (infra/backup, a separate Railway cron service; docs/runbooks/backup-restore.md) ----------
# It also takes DATABASE_URL, TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID, all as references.
# age PUBLIC key(s) the nightly dump is encrypted to (age1..., space separated). Never the private key.
BACKUP_AGE_RECIPIENT=
# An S3-compatible bucket outside Railway (Backblaze B2, Cloudflare R2, AWS S3).
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=rat/
# [SECRET] a key limited to that bucket
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Optional: pinged after every good backup (for example a healthchecks.io check), so a missed night alerts you.
BACKUP_HEARTBEAT_URL=
